# Orchestrator environment. Copy to `orchestrator/.env` (gitignored) and fill in.
#
# NOTHING here is VITE_-prefixed, and nothing here may ever become VITE_: this
# file holds a real secret, and any VITE_ var is bundled into the browser. The
# key stays server-side — that is the whole reason this process exists.

# Required. Your Anthropic API key — https://console.anthropic.com/settings/keys
# Replace the whole placeholder: a real key is ~100+ chars, not "sk-ant-...".
# Leaving this as-is gets a 401 "invalid x-api-key", which reads like a code bug
# but is not one. Use a key dedicated to this app so the Console's per-key cost
# column keeps showing what the dashboard actually spends.
ANTHROPIC_API_KEY=REPLACE_ME

# Optional. Which model /architect draws with. Defaults to claude-sonnet-5 —
# ample for turning a sentence into a handful of blocks, and well under
# claude-opus-4-8 per prompt. claude-haiku-4-5 is the cheap floor; opus is there
# if a diagram genuinely needs better judgement.
ARCHITECT_MODEL=claude-sonnet-5

# Optional. low | medium | high | xhigh | max. Lower = cheaper + faster, at the
# cost of thinking depth. medium suits a graph this small; drop to low if you
# iterate hard on prompts and cost adds up.
ARCHITECT_EFFORT=medium

# Optional. Port to bind on loopback (must match VITE_OS_ORCHESTRATOR_BASE).
ORCHESTRATOR_PORT=8787

# Optional. Comma-separated browser origins allowed to call this server.
# Defaults to the Vite dev server + preview. Do not add a public origin: this
# process holds your API key and can run Claude Code on your filesystem.
ORCHESTRATOR_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173

# ---------------------------------------------------------------------------
# HOSTED ONLY (Railway). None of this is needed on the laptop — locally the
# server binds loopback, runs with auth off, and keeps diagrams in the repo.
#
# The server treats itself as hosted the moment PORT or DATABASE_URL is set, and
# it *refuses to boot* hosted without OS_PASSWORD. That interlock is deliberate:
# a public URL + an API key + no password is an open proxy billed to you.
# ---------------------------------------------------------------------------

# Required when hosted. The password the login screen asks for. Long and random —
# it is the only thing between the internet and your Anthropic key.
# OS_PASSWORD=

# Required when hosted. HMAC key for the session cookie, >= 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset means a fresh random secret per boot, so every redeploy signs you out.
# OS_SESSION_SECRET=

# Switches the canvas from `architectures/*.json` to a table — a container's disk
# is ephemeral, so without this a redeploy would take every diagram with it.
#
# RAILWAY DOES NOT SET THIS FOR YOU. Adding a Postgres to the project creates a
# separate service that owns the variable; nothing is inherited. On the *app*
# service add a reference variable, exactly:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
# (substitute the Postgres service's actual name). Miss this and the app boots
# perfectly happily on the file backend and quietly loses every diagram on the
# next deploy — the failure is silent, which is why it is worth checking the boot
# log for `architectures: postgres (postgres)` rather than assuming.
# DATABASE_URL=

# Set to `disable` if the boot log shows "The server does not support SSL
# connections". Railway's Postgres image is SSL-enabled, but the in-project
# private endpoint (postgres.railway.internal) commonly does not negotiate TLS,
# and we default to requiring it. Turning it off is not a real exposure there:
# that network is private to this project and never leaves it.
# PGSSLMODE=disable

# Railway sets PORT itself. Don't set it by hand.
